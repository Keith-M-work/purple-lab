/* =============================================================================
   Splunk — LSASS Credential Dumping (T1003.001)
   Tactic: Credential Access (TA0006) | Platform: Windows
   Author: Keith M | Version: 2.0 | Updated: 2026-07-24
   Language: SPL
   Data source: Sysmon EID 10 (ProcessAccess) + EID 1 (ProcessCreate)
   Requires: Splunk_TA_microsoft-sysmon
   ============================================================================= */


/* -----------------------------------------------------------------------------
   1. PRIMARY — handle access to lsass.exe with dumping-grade access masks
      0x1010 0x1410 0x1438 0x143a 0x147a 0x1f0fff 0x1f1fff 0x1fffff
   ----------------------------------------------------------------------------- */
index=windows sourcetype="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational"
    EventCode=10 TargetImage="*\\lsass.exe"
| eval GrantedAccess=lower(GrantedAccess), src=lower(SourceImage)
| where GrantedAccess IN ("0x1010","0x1410","0x1438","0x143a","0x147a","0x1f0fff","0x1f1fff","0x1fffff")
| where NOT match(src,"\\\\(werfault|werfaultsecure|msmpeng)\.exe$")
| eval susp_source=if(match(src,
    "\\\\(procdump\d*|rundll32|taskmgr|powershell|pwsh|python\d*|mimikatz|nanodump|dumpert|handlekatz|lsassy)\.exe$"),
    "yes","no")
| stats count as hits, min(_time) as firstTime, max(_time) as lastTime,
        values(GrantedAccess) as GrantedAccess, values(CallTrace) as CallTrace,
        values(susp_source) as susp_source
    by host, SourceImage, TargetImage
| where susp_source="yes" OR hits < 50
| convert ctime(firstTime) ctime(lastTime)
| sort - hits


/* -----------------------------------------------------------------------------
   2. UNBACKED CALL TRACE — injected/reflectively-loaded dumping code.
      Mask-independent, so it survives an attacker tuning their access rights.
   ----------------------------------------------------------------------------- */
index=windows sourcetype="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational"
    EventCode=10 TargetImage="*\\lsass.exe" CallTrace="*UNKNOWN*"
| eval src=lower(SourceImage)
| where NOT match(src,"\\\\(werfault|werfaultsecure)\.exe$")
| stats count as hits, values(CallTrace) as CallTrace by host, SourceImage
| sort - hits


/* -----------------------------------------------------------------------------
   3. COMMAND LINE — comsvcs MiniDump, procdump, named tooling.
      Matches on the command line, so renaming the binary does not evade.
   ----------------------------------------------------------------------------- */
index=windows sourcetype="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1
| eval cl=lower(CommandLine)
| where (match(cl,"comsvcs") AND match(cl,"minidump|#\s*24"))
     OR (match(cl,"procdump") AND match(cl,"lsass"))
     OR  match(cl,"nanodump|handlekatz|dumpert|pypykatz|lsassy|sekurlsa|mimikatz|safetykatz")
     OR (match(cl,"lsass") AND match(cl,"minidumpwritedump|createdump"))
| stats count as hits, min(_time) as firstTime, max(_time) as lastTime,
        values(CommandLine) as CommandLine, values(ParentImage) as ParentImage
    by host, User, Image
| convert ctime(firstTime) ctime(lastTime)
| sort - hits


/* -----------------------------------------------------------------------------
   4. CORRELATION — dump command followed by a .dmp write on the same host
      within 10 minutes. Higher fidelity than either half alone.
   ----------------------------------------------------------------------------- */
index=windows sourcetype="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational"
    (EventCode=1 OR EventCode=11)
| eval cl=lower(CommandLine), tf=lower(TargetFilename)
| eval stage=case(
    EventCode=1 AND match(cl,"lsass") AND match(cl,"comsvcs|procdump|minidump|nanodump"), "dump_exec",
    EventCode=11 AND match(tf,"\.dmp$"), "dmp_write",
    true(), null())
| where isnotnull(stage)
| bin _time span=10m
| stats dc(stage) as stages, values(stage) as stages_seen,
        values(CommandLine) as CommandLine, values(TargetFilename) as TargetFilename
    by _time, host
| where stages=2


/* -----------------------------------------------------------------------------
   5. HUNT — rare LSASS-accessing processes. Sorted ascending on purpose:
      the uncommon source process is the interesting one.
   ----------------------------------------------------------------------------- */
index=windows sourcetype="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational"
    EventCode=10 TargetImage="*\\lsass.exe" earliest=-30d
| stats count as hits, dc(host) as hosts by SourceImage
| where hosts <= 2
| sort + hits


/* =============================================================================
   savedsearches.conf — $SPLUNK_HOME/etc/apps/<app>/local/savedsearches.conf
   ============================================================================= */
/*
[Credential Access - LSASS Memory Dump (T1003.001)]
search = index=windows sourcetype="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=10 TargetImage="*\\lsass.exe" | eval GrantedAccess=lower(GrantedAccess), src=lower(SourceImage) | where GrantedAccess IN ("0x1010","0x1410","0x1438","0x143a","0x147a","0x1f0fff","0x1f1fff","0x1fffff") | where NOT match(src,"\\\\(werfault|werfaultsecure|msmpeng)\.exe$") | eval susp_source=if(match(src,"\\\\(procdump\d*|rundll32|taskmgr|powershell|pwsh|python\d*|mimikatz|nanodump|dumpert|handlekatz|lsassy)\.exe$"),"yes","no") | stats count as hits values(GrantedAccess) as GrantedAccess values(susp_source) as susp_source by host, SourceImage, TargetImage | where susp_source="yes" OR hits < 50
dispatch.earliest_time = -60m@m
dispatch.latest_time = now
cron_schedule = */10 * * * *
enableSched = 1
alert.severity = 4
alert.track = 1
action.notable = 1
action.notable.param.rule_title = Credential Access - LSASS Memory Dump (T1003.001)
action.notable.param.security_domain = endpoint
description = Detects LSASS memory access consistent with T1003.001 (Mimikatz, procdump, comsvcs MiniDump, nanodump). Tune WerFault/AV sources per environment.

[Credential Access - LSASS Dump Tooling Command Line (T1003.001)]
search = index=windows sourcetype="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1 | eval cl=lower(CommandLine) | where (match(cl,"comsvcs") AND match(cl,"minidump|#\s*24")) OR (match(cl,"procdump") AND match(cl,"lsass")) OR match(cl,"nanodump|handlekatz|dumpert|pypykatz|lsassy|sekurlsa|mimikatz|safetykatz") | stats count as hits values(CommandLine) as CommandLine values(ParentImage) as ParentImage by host, User, Image
dispatch.earliest_time = -60m@m
dispatch.latest_time = now
cron_schedule = */10 * * * *
enableSched = 1
alert.severity = 4
action.notable = 1
description = Detects LSASS dumping driven from the command line, matched on CommandLine so renamed binaries still fire.
*/


/* =============================================================================
   MITRE ATT&CK
     TA0006 Credential Access / T1003 OS Credential Dumping / T1003.001 LSASS Memory
     https://attack.mitre.org/techniques/T1003/001/

   FALSE POSITIVES
     - WerFault.exe crash reporting opens LSASS legitimately (filtered).
     - AV/EDR (MsMpEng.exe), backup and DLP agents.
     - IR and purple-team tooling, including this lab's validation runs.

   TUNING
     - Build a lookup of approved SourceImage paths:
         | search NOT [ | inputlookup lsass_approved_sources | fields SourceImage ]
     - Baseline hits-per-host over 7d and alert on deviation, not raw volume.

   VALIDATION (this lab)
     rundll32.exe comsvcs.dll, MiniDump <pid> C:\Windows\Temp\lsass.dmp full
     procdump64.exe -accepteula -ma lsass.exe out.dmp
     Atomic Red Team T1003.001 via the lab safe runner (snapshot first).
   ============================================================================= */
