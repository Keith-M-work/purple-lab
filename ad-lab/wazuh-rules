<!--
  Custom Wazuh Detection Rules - Purple Team Lab
  
  Deploy to: /var/ossec/etc/rules/local_rules.xml on the Wazuh Manager
  Restart after deployment: sudo systemctl restart wazuh-manager
  
  These rules detect common attack techniques executed during
  purple team exercises. Each rule maps to a MITRE ATT&CK technique
  and correlates Sysmon event data.
  
  Prerequisite: Sysmon installed on endpoints with Olaf Hartong's
  modular configuration (sysmon-modular).
-->

<group name="purple-team,attack-detection,">

  <!-- ============================================================
       CREDENTIAL ACCESS - LSASS Memory Dump (T1003.001)
       Sysmon Event 10: Process Access
       Detects non-system processes accessing LSASS memory
       ============================================================ -->
  <rule id="100100" level="15">
    <if_sid>61612</if_sid>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)\\\\lsass\\.exe$</field>
    <field name="win.eventdata.sourceImage" negate="yes" type="pcre2">(?i)(csrss|lsass|MsMpEng|wininit|svchost)\\.exe$</field>
    <description>CRITICAL: Non-system process accessed LSASS memory - Possible credential dumping</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
    <group>credential_access,lsass,</group>
  </rule>

  <!-- ============================================================
       CREDENTIAL ACCESS - comsvcs.dll MiniDump (T1003.001)
       Sysmon Event 1: Process Create
       Detects use of comsvcs.dll to dump LSASS via MiniDump
       ============================================================ -->
  <rule id="100101" level="14">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)comsvcs.*MiniDump</field>
    <description>Credential dumping via comsvcs.dll MiniDump technique detected</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
    <group>credential_access,lsass,</group>
  </rule>

  <!-- ============================================================
       DEFENSE EVASION - Process Injection (T1055)
       Sysmon Event 8: CreateRemoteThread
       Detects remote thread creation targeting common injection hosts
       ============================================================ -->
  <rule id="100200" level="14">
    <if_sid>61618</if_sid>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)(explorer|svchost|RuntimeBroker)\\.exe$</field>
    <description>Possible process injection via CreateRemoteThread into system process</description>
    <mitre>
      <id>T1055</id>
    </mitre>
    <group>defense_evasion,process_injection,</group>
  </rule>

  <!-- ============================================================
       PERSISTENCE - Registry Run Keys (T1547.001)
       Sysmon Event 12/13: Registry Value Set
       Detects Run key entries pointing to suspicious directories
       ============================================================ -->
  <rule id="100300" level="12">
    <if_sid>61614</if_sid>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)\\\\Run\\\\</field>
    <field name="win.eventdata.details" type="pcre2">(?i)(Temp|AppData|Downloads)</field>
    <description>Persistence: Registry Run key pointing to suspicious directory</description>
    <mitre>
      <id>T1547.001</id>
    </mitre>
    <group>persistence,registry,</group>
  </rule>

  <!-- ============================================================
       COMMAND AND CONTROL - HTTPS Beaconing (T1573.002)
       Sysmon Event 3: Network Connection
       Detects non-browser processes making repeated HTTPS connections
       Frequency-based: 5+ connections in 60 seconds
       ============================================================ -->
  <rule id="100400" level="10" frequency="5" timeframe="60">
    <if_matched_sid>61605</if_matched_sid>
    <field name="win.eventdata.destinationPort">443</field>
    <field name="win.eventdata.image" negate="yes" type="pcre2">(?i)(chrome|firefox|edge|teams|outlook|onedrive)\\.exe$</field>
    <description>Possible C2 beaconing: Non-browser process making repeated HTTPS connections</description>
    <mitre>
      <id>T1573.002</id>
    </mitre>
    <group>command_and_control,beaconing,</group>
  </rule>

  <!-- ============================================================
       EXECUTION - Suspicious Parent-Child Process (T1059.001)
       Sysmon Event 1: Process Create
       Detects mshta.exe spawning powershell (common dropper chain)
       ============================================================ -->
  <rule id="100500" level="14">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)mshta\\.exe$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)powershell\\.exe$</field>
    <description>Suspicious execution chain: mshta.exe spawned PowerShell - Possible HTA dropper</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
    <group>execution,initial_access,</group>
  </rule>

  <!-- ============================================================
       DISCOVERY - BloodHound/SharpHound Collection (T1087.002)
       Sysmon Event 1: Process Create
       Detects SharpHound execution patterns
       ============================================================ -->
  <rule id="100600" level="12">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(SharpHound|bloodhound|Invoke-BloodHound)</field>
    <description>BloodHound/SharpHound AD enumeration tool detected</description>
    <mitre>
      <id>T1087.002</id>
    </mitre>
    <group>discovery,ad_enumeration,</group>
  </rule>

  <!-- ============================================================
       CREDENTIAL ACCESS - Kerberoasting (T1558.003)
       Windows Security Event 4769
       Detects TGS requests using RC4 encryption (downgrade indicator)
       ============================================================ -->
  <rule id="100700" level="12">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">4769</field>
    <field name="win.eventdata.ticketEncryptionType">0x17</field>
    <description>Possible Kerberoasting: TGS request using RC4 encryption (downgrade)</description>
    <mitre>
      <id>T1558.003</id>
    </mitre>
    <group>credential_access,kerberoasting,</group>
  </rule>

</group>
